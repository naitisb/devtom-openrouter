# Copy to .env and fill in. NEVER commit .env.
# This project routes ALL model calls through OpenRouter (one key, many open models).
OPENROUTER_API_KEY=

# --- Direct provider keys (OPTIONAL — hosted historical panel only) ---
# Only needed to eval the direct-API entries of devtom-selfhost's
# models/manifest-expanded.yaml (Inspect model strings openai/<id> /
# anthropic/<id>); Inspect's providers read these exact env vars. Roster models
# routed through OpenRouter never touch these.
#
# Surviving deprecated GPT snapshots (gpt-3.5-turbo-1106, gpt-4-0613,
# gpt-4-turbo-2024-04-09, gpt-4o-2024-05-13) retire 2026-10-23 — sweep first.
# OPENAI_API_KEY=
#
# For the direct Claude panel (Opus 4.1 onward — every id <=3.7 is retired; the
# lone historical point, claude-3-haiku, routes via OPENROUTER_API_KEY instead).
# claude-opus-4-1 retires 2026-08-05: sweep first.
# ANTHROPIC_API_KEY=

# Optional but STRONGLY recommended for the free-response task: pin one strong,
# policy-compliant judge so every model under test is graded by the same fixed
# grader (a small open model self-grading its ToM reasoning is unreliable, and a
# shared judge removes a confound). An openrouter/* grader is routed through the
# same no-training/ZDR prefs as the models under test. See src/scorer.py.
# DEVTOM_GRADER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
#
# Cross-family grading (avoids LLM-judge self-preference bias): if set, the
# SAMEFAMILY grader is used ONLY for subjects that share the PRIMARY judge's
# family, so no model is graded by a judge of its own family. E.g. primary =
# Llama-3.3-70b (grades Qwen/DeepSeek/Mistral/Gemma) + this alternate = Nemotron
# (grades the Llama family). See src/scorer.py.
# DEVTOM_GRADER_MODEL_SAMEFAMILY=openrouter/nvidia/nemotron-3-super-120b-a12b
#
# Optional: cap the grader's own output (default 8192). Prevents the grading call
# from reserving the model's full default max_tokens and 402-ing on a small key.
# GRADER_MAX_TOKENS=8192
